# Database Configuration (Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bikers_demand?schema=public"

# NextAuth Secret
NEXTAUTH_SECRET="bikers-demand-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Admin panel credentials (env-credential gate for /admin)
ADMIN_EMAIL="admin@bikersdemand.com"
ADMIN_PASSWORD="change-this-admin-password"
ADMIN_SESSION_SECRET="optional-dedicated-session-signing-key"

# Storage (S3 / Local Uploads)
S3_BUCKET_NAME="bikers-demand-assets"
S3_REGION="ap-southeast-1"
